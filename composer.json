{
    "name": "seo-control-center/app",
    "description": "SEO Control Center: free, open source, self-hosted SEO software for shared hosting.",
    "keywords": ["seo", "seo-tools", "self-hosted", "search-console", "site-audit", "rank-tracking", "mcp"],
    "homepage": "https://seocc.net/",
    "support": {
        "issues": "https://github.com/seoccnet/seo-control-center/issues",
        "source": "https://github.com/seoccnet/seo-control-center"
    },
    "type": "project",
    "license": "AGPL-3.0-only",
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "nikic/fast-route": "^1.3",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "SeoControlCenter\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SeoControlCenter\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": true
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
